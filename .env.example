# URL сервера vLLM (OpenAI-совместимый API). vLLM запускается отдельно (на хосте или в другом контейнере).
# Если comboocr в Docker, а vLLM на том же хосте:
#   Windows/Mac:  VLLM_BASE_URL=http://host.docker.internal:8000/v1
#   Linux:        VLLM_BASE_URL=http://172.17.0.1:8000/v1
# Если оба на хосте (без Docker):  VLLM_BASE_URL=http://localhost:8000/v1
VLLM_BASE_URL=http://host.docker.internal:8000/v1

# Имя модели на vLLM (должно совпадать с выводом curl http://<vllm>:8000/v1/models)
VLLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct

# Опционально: API key (vLLM часто без ключа)
# VLLM_API_KEY=

# Таймаут запроса к VLM (секунды) и макс. токенов ответа
VLLM_TIMEOUT_SECONDS=120
VLLM_MAX_TOKENS=512
# Для распознавания таблиц (в т.ч. рукописный текст) — больший лимит
VLLM_MAX_TOKENS_TABLE=2048

# DPI при конвертации PDF в изображения (меньше — меньше размер картинки и токенов в VLM)
PDF_DPI=150
